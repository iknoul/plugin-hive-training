{
  "name": "shiphub-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "docker:check": "docker build --check .",
    "check": "npm run lint && npm shiphub-test && npm run docker:check",
    "shiphub-test": "node --test tests/unit-test.js",

    "dev": "nodemon server.js",
    "start": "node server.js",
    "setup": "node scripts/env-setup.js",

    "db:explain": "node --env-file=.env scripts/explain-query.js",
    "db:seed-order": "node --env-file=.env seeders/order-seeder.js",
    "db:seed-seller": "node --env-file=.env seeders/seller-seeder.js",
    "db:seed-pickup-addres": "node --env-file=.env seeders/pickup_addres-seeder.js",
    "db:order-migrate": "node --env-file=.env  migrations/backfill-order-priority.js",
    "db:migrate-pg": "node migrations/pg-migration.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "mongoose": "^9.12.1",
    "pg": "^8.23.1",
    "shiphub-capstone": "file:.."
  }
}
